# GeckoBoard configuration template. Copy to .env for local runs (npm start loads it automatically) or paste into Render → Environment.
# Never commit a real .env.

# --- required on a server ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com   # Google Sign-in (OAuth client, type Web)
ADMIN_EMAIL=you@example.com                            # first admin
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require   # without it, data is kept in data/db.json
NODE_VERSION=22

# --- optional ---
# PORT=3000
# PUBLIC_URL=https://your-host.example.com   # used for links in Discord messages and keep-awake (Render sets RENDER_EXTERNAL_URL itself)
# KEEP_AWAKE=0                               # 0 = do not self-ping (use UptimeRobot / a paid plan)
# DISCORD_WEBHOOK_URL=
# DISCORD_TESTER_ROLE_ID=
# DISCORD_LANG=th                            # th | en
# FILE_BUDGET_MB=300
# FILE_KEEP_DAYS=14
# BACKUP_KEEP=14
# DEFAULT_PROJECT_NAME=Main
# DEFAULT_PROJECT_KEY=MAIN

# --- local testing only (never on production) ---
# ALLOW_INSECURE_EMAIL_LOGIN=1
